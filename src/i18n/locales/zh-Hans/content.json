  "lessons": {
    "1.1": {
      "title": "认识棒球场",
      "objective": "认识整个棒球场：内野、外野和界外线。",
      "demo": [
        "欢迎来到棒球场！棒球场在英语里叫 diamond，意思是钻石。",
        "看：有四个角的泥土部分是内野，英语叫 infield。",
        "后面那片又大又绿的地方是外野，英语叫 outfield。",
        "这两条往两边延伸的白线是界外线：它们把好的场地和不好的场地分开。"
      ],
      "acts": {
        "1": {
          "q": "点一下有垒包的泥土部分",
          "ok": "对了！垒包就在那里。",
          "ko": "差一点：找中间的泥土部分。",
          "answer": "内野 (infield)"
        },
        "2": {
          "q": "内野后面那片又大又绿的地方叫什么？",
          "ok": "正确！英语叫 outfield。",
          "ko": "再看看：是离本垒最远的绿色部分。",
          "opts": {
            "outfield": "外野 (outfield)",
            "dugout": "休息区",
            "home": "本垒"
          }
        },
        "3": {
          "q": "两边的白线叫界外线",
          "ok": "对！英语叫 foul lines。",
          "ko": "这是对的：那些线就叫界外线。"
        },
        "4": {
          "q": "点一下界外线",
          "ok": "点得好！",
          "ko": "不是那个：界外线从本垒向两边延伸。",
          "answer": "界外线 (foul line)"
        },
        "5": {
          "q": "为什么棒球场被叫作钻石（diamond）？",
          "ok": "对了！英语叫 diamond。",
          "ko": "看看内野的形状：像一颗钻石。",
          "opts": {
            "shape": "因为它的形状像一颗转过来的钻石",
            "money": "因为它很值钱",
            "glass": "因为它是玻璃做的"
          }
        },
        "6": {
          "q": "球飞得很远时，在哪里防守？",
          "ok": "正确！很远的地方，就是外野（outfield）。",
          "ko": "离本垒很远：在外野。",
          "opts": {
            "outfield": "在外野",
            "dugout": "在休息区",
            "home": "在本垒"
          }
        }
      }
    },
    "1.2": {
      "title": "按顺序跑垒",
      "objective": "按正确顺序跑过一垒、二垒、三垒，方向永远一样。",
      "demo": [
        "击球后，你不能随便乱跑：要按顺序跑。",
        "先跑一垒，英语叫 first base。",
        "然后是二垒，second base。",
        "再然后是三垒，third base。",
        "总是朝同一个方向绕一圈，像一个正方形。看我跑一次！"
      ],
      "acts": {
        "1": {
          "q": "你打出去了。点一下你最先跑向的垒",
          "ok": "对了！永远先跑一垒。",
          "ko": "不对：第一站永远是一垒。",
          "answer": "一垒 (first base)"
        },
        "2": {
          "q": "跑完一垒以后，下一个是哪个垒？",
          "ok": "正确！二垒，second base。",
          "ko": "顺序是 1、2、3：先到二垒。",
          "opts": {
            "second": "二垒",
            "third": "三垒",
            "home": "本垒"
          }
        },
        "3": {
          "q": "把跑垒员按顺序拖到三垒",
          "ok": "路线完美！",
          "ko": "顺序不能跳：一垒、二垒，然后三垒。",
          "answer": "一垒、二垒、三垒"
        },
        "4": {
          "q": "跑垒员可以从一垒直接跑到三垒，跳过二垒",
          "ok": "很好！每个垒都要踩。",
          "ko": "错：中途一定要踩二垒。"
        },
        "5": {
          "q": "跑垒的路线是什么形状？",
          "ok": "对了！所以叫它 diamond（钻石）。",
          "ko": "四个角：是一个转过来的正方形。",
          "opts": {
            "square": "正方形",
            "circle": "圆形",
            "triangle": "三角形"
          }
        },
        "6": {
          "q": "点一下三垒",
          "ok": "很好！那是回本垒前的最后一个垒。",
          "ko": "三垒在另一边，就在回到本垒之前。",
          "answer": "三垒 (third base)"
        }
      }
    },
    "1.3": {
      "title": "本垒：一切开始和结束的地方",
      "objective": "知道在本垒击球、从本垒出发、踩到本垒就得分。",
      "demo": [
        "这个特别的角不是普通的垒：它是本垒，英语叫 home plate。",
        "你站在这里击球，也从这里开始跑。",
        "如果你跑完一圈又踩到本垒，你就得分了！英语叫 run。"
