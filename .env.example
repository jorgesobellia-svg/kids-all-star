# Copia este archivo como .env y llena los valores. Sin valores, la app funciona en modo de prueba.

# RevenueCat (suscripción Plus). Claves PÚBLICAS de la app en RevenueCat > Project settings > API keys.
EXPO_PUBLIC_RC_IOS_KEY=
EXPO_PUBLIC_RC_ANDROID_KEY=

# Firebase (scoreboard). Firebase console > Project settings > Your apps > Web app config.
EXPO_PUBLIC_FIREBASE_API_KEY=
EXPO_PUBLIC_FIREBASE_AUTH_DOMAIN=
EXPO_PUBLIC_FIREBASE_PROJECT_ID=
EXPO_PUBLIC_FIREBASE_APP_ID=
